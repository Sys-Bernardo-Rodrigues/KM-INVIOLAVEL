<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Login - KM Control</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate icon" href="/favicon.ico" sizes="any">
  <meta name="theme-color" content="#111827">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="login-body">

  <div class="login-wrapper">
    <div class="login-card" role="dialog" aria-label="Login">
      <div class="login-logo" aria-hidden="true">
        <span class="logo-badge">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="2"/>
            <path d="M8 11V8a4 4 0 1 1 8 0v3" stroke="currentColor" stroke-width="2"/>
          </svg>
        </span>
      </div>

      <form action="/login" method="POST" novalidate>
        <div class="field">
          <label for="username">Usuário</label>
          <div class="input with-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="12" cy="8" r="4" stroke="#6b7280" stroke-width="2"/>
              <path d="M4 20c0-4 4-6 8-6s8 2 8 6" stroke="#6b7280" stroke-width="2"/>
            </svg>
            <input id="username" type="text" name="username" placeholder="Seu usuário" autocomplete="username" required onInput="this.value = this.value.toLowerCase()">
          </div>
        </div>

        <div class="field">
          <label for="password">Senha</label>
          <div class="input with-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M6 10V8a6 6 0 1 1 12 0v2" stroke="#6b7280" stroke-width="2"/>
              <rect x="5" y="10" width="14" height="10" rx="2" stroke="#6b7280" stroke-width="2"/>
            </svg>
            <input id="password" type="password" name="password" placeholder="Sua senha" autocomplete="current-password" required>
            <button id="togglePassword" type="button" class="password-toggle" aria-label="Mostrar/ocultar senha">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6S2 12 2 12Z" stroke="#6b7280" stroke-width="2"/>
                <circle cx="12" cy="12" r="3" stroke="#6b7280" stroke-width="2"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="form-row">
          <label class="checkbox" style="display:flex; align-items:center; gap:8px;">
            <input type="checkbox" name="remember">
            <span>Lembrar-me</span>
          </label>
        </div>

        <% if (typeof mensagem !== 'undefined' && mensagem) { %>
          <div class="alert error" role="alert" aria-live="assertive" style="margin-top:8px;">
            <i class="fas fa-circle-info" aria-hidden="true"></i>
            <span><%= mensagem %></span>
          </div>
        <% } %>
        <p id="error-msg" class="error-text" style="display:none"></p>
        <button type="submit" class="btn btn-purple full">Entrar</button>
      </form>
    </div>
  </div>

  <script>
    (function() {
      const form = document.querySelector('form');
      const user = form.elements['username'];
      const pass = form.elements['password'];
      const err = document.getElementById('error-msg');
      const toggle = document.getElementById('togglePassword');

      toggle.addEventListener('click', () => {
        const isPwd = pass.type === 'password';
        pass.type = isPwd ? 'text' : 'password';
        toggle.innerHTML = isPwd
          ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6S2 12 2 12Z" stroke="#6b7280" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="#6b7280" stroke-width="2"/><path d="M3 3l18 18" stroke="#6b7280" stroke-width="2"/></svg>'
          : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6S2 12 2 12Z" stroke="#6b7280" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="#6b7280" stroke-width="2"/></svg>';
      });

      form.addEventListener('submit', (e) => {
        user.value = (user.value || '').trim().toLowerCase();
        pass.value = (pass.value || '').trim();
        if (!user.value || !pass.value) {
          e.preventDefault();
          err.textContent = 'Informe usuário e senha.';
          err.style.display = 'block';
          return;
        }
        err.style.display = 'none';
      });
    })();
  </script>
</body>
</html>